<UserControl x:Class="KeyframeStudio.Native.NativeValueEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ymm="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Plugin"
 x:Name="EditorRoot" MinWidth="0">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
  <ymm:TextBoxSlider x:Name="Number" MinWidth="0"
   Value="{Binding Value, ElementName=EditorRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
   BeginEdit="BeginNumberEdit" EndEdit="EndNumberEdit"/>
  <Button x:Name="Diamond" Grid.Column="1" Content="◇" Padding="0" Margin="2,0,0,0"
   ToolTip="現在位置のキーフレームを追加／削除" Click="ToggleKey"/>
 </Grid>
</UserControl>
